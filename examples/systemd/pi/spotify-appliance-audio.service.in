# Render @AUDIO_STREAM_URL@ with a locally configured stream URL before installing.
# Do not enable this service; the switch controller starts and stops it on demand.
[Unit]
Description=SpotifyTouch on-demand audio consumer
After=pipewire-pulse.service

[Service]
Type=simple
ExecStart=/usr/bin/mpv --no-video --ao=pulse --force-window=no --no-terminal --profile=low-latency --cache=no --demuxer-readahead-secs=0 --audio-buffer=0.12 @AUDIO_STREAM_URL@
Restart=on-failure
RestartSec=3
