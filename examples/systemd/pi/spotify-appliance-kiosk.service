# Reference template. Requires the kiosk viewer and a functioning labwc/Wayland session.
[Unit]
Description=SpotifyTouch persistent kiosk viewer
After=spotify-appliance-switch.service
Wants=spotify-appliance-switch.service

[Service]
Type=simple
ExecStart=%h/.local/share/spotify-appliance/launch-viewer.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=default.target
