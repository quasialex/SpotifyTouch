# Example only. Copy to a private location; do not commit real values.
# This file is not yet consumed by an installer. Source consolidation is ongoing.
#
# Raspberry Pi -> Ubuntu control API (SSH tunnel)
SPOTIFY_SSH_HOST=ubuntu-host.example.lan
SPOTIFY_SSH_USER=spotify-user
SPOTIFY_SSH_IDENTITY_FILE=/home/pi-user/.ssh/spotify_remote_ed25519
SPOTIFY_CONTROL_PORT=16080
#
# Ubuntu -> Raspberry Pi audio stream (trusted LAN)
SPOTIFY_AUDIO_STREAM_URL=http://ubuntu-host.example.lan:18080/spotify.ts
#
# On-demand Pi Bluetooth output (replace with locally paired speaker)
SPOTIFY_BLUETOOTH_MAC=AA:BB:CC:DD:EE:FF
#
# Optional MagicMirror profile (server-only, IPv6 loopback in reference deployment)
MAGICMIRROR_URL=http://[::1]:8080/
SPOTIFY_SWITCH_PORT=16181
#
# Upstream image must be pinned to a tested immutable digest or release ref before deployment.
# The live reference host currently uses a mutable "latest" tag; DO NOT copy that for releases.
SPOTIFY_HEADLESS_IMAGE=ghcr.io/kk-spartans/spotify-headless@sha256:REPLACE_WITH_TESTED_DIGEST
